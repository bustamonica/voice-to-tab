# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored. NEVER commit secrets.

# --- Clerk (auth) ----------------------------------------------------------
# Get these from https://dashboard.clerk.com after creating an application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Optional: customize where Clerk's hosted sign-in / sign-up pages live.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Subscription gating (Phase 2 will wire these to Stripe + Supabase) ----
# How many seconds of free recording before the paywall trips.
NEXT_PUBLIC_FREE_RECORDING_SECONDS=10

# --- Stripe (will be used in Phase 3) --------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_MONTHLY=price_xxx
# STRIPE_PRICE_YEARLY=price_xxx

# --- Supabase (will be used in Phase 3) ------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJxxx
