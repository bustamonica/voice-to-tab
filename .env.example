# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. NEVER commit secrets.

# --- Clerk (auth) ----------------------------------------------------------
# https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Free tier ------------------------------------------------------------
# Notes that start after this many seconds are locked for non-premium users.
NEXT_PUBLIC_FREE_RECORDING_SECONDS=10

# --- Stripe ---------------------------------------------------------------
# https://dashboard.stripe.com (use test mode while developing)
STRIPE_SECRET_KEY=sk_test_xxx
# Created when you set up a webhook endpoint (or via `stripe listen --forward-to`)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Create one Product with two recurring Prices ($4.99/mo and $49.99/yr) in
# Stripe Dashboard -> Products -> Add product. Paste the price IDs here.
STRIPE_PRICE_MONTHLY=price_xxx_monthly
STRIPE_PRICE_YEARLY=price_xxx_yearly

# --- Supabase -------------------------------------------------------------
# https://supabase.com -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
# Service role: NEVER expose this to the client. Used only by webhook handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx
